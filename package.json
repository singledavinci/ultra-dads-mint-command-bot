{
  "name": "ultra-dads-mint-command-bot",
  "private": true,
  "version": "0.0.0",
  "description": "Telegram mint, dropmint, blockmint, and wallet command bot",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/apps/mint-command-bot/index.ts",
    "dev": "tsx src/apps/mint-command-bot/index.ts",
    "register": "tsx src/apps/mint-command-bot/registerCommands.ts",
    "test": "tsx tests/run-all.ts",
    "test:smoke": "tsx tests/smoke/run-smoke.ts",
    "ci": "npm run check:encoding && npm run audit:ci && npm run typecheck && npm test && npm run test:smoke",
    "audit:ci": "node scripts/npm-audit-ci.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.bot.json",
    "check:encoding": "node scripts/check-encoding.mjs",
    "prestart": "node scripts/check-encoding.mjs",
    "build:dashboard": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@manifoldxyz/studio-apps-client-public": "1.0.0-beta.0",
    "axios": "1.16.1",
    "dotenv": "17.3.1",
    "ethers": "6.16.0",
    "express": "5.2.1",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.574.0",
    "mongoose": "9.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "telegraf": "4.16.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
