# =====================================================================
# Mint Command Bot — standalone repo (.env.example)
# Dedicated Telegram bot + Railway project + RPC for manual/scheduled mints.
# =====================================================================

BOT_ROLE=mint
MINT_BOT_ENABLED=true
COPY_BOT_ENABLED=false

# ---- Telegram (separate BotFather bot from copy-mint) ----
MINT_BOT_TOKEN=
PERSONAL_ID=
GROUP_ID=

# ---- Persistence ----
MONGODB_URI=

# ---- Wallets ----
MNEMONIC=
IMPORTED_KEYS=

# ---- RPC (mint execution — no tracker WebSocket required) ----
PROVIDER_URL=https://your-mint-rpc.example/v2/KEY
EXECUTION_RPC_URL=
BACKUP_RPC_URLS=
# Optional: disable mempool features on this service
ENABLE_PENDING_DETECTION=false
ENABLE_BLOCK_FALLBACK=true

RPC_FAILOVER_ENABLED=true
RPC_TIMEOUT_MS=8000
EXECUTION_CONCURRENCY=4

# ---- HTTP / dashboard ----
PORT=3000
API_SECRET=
NODE_ENV=production

# ---- Inclusion / gas ----
BUILDER_MINT_ENABLED=false
# INCLUSION_MODE=public

# TELEGRAM_WEBHOOK_MODE=true
# TELEGRAM_WEBHOOK_BASE_URL=https://your-mint-service.up.railway.app
